# Copy to .env for local production-style runs (do NOT commit .env).
ENV=production
SECRET_KEY=replace-with-a-long-random-string
SEED_MODE=demo            # demo | minimal | none
DATA_DIR=./data           # where the SQLite file + uploads live
PROXY_FIX_HOPS=1
